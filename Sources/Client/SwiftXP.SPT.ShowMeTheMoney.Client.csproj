<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- SPT 5.0 runs the game under IL2CPP, so the plugin is a BepInEx 6 / .NET 10 plugin.
         The old netstandard2.1 + EscapeFromTarkov_Data\Managed setup no longer exists. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>4.2.0</Version>
    <SptComponent>Client</SptComponent>

    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- Every referenced assembly is shipped by SPT, so nothing may be copied beside the plugin. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <AssemblyName>SwiftXP.SPT.ShowMeTheMoney.Client</AssemblyName>
    <Product>Show Me The Money</Product>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>SwiftXP.SPT.ShowMeTheMoney.Client</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <LicenseToolPath>$(HOME)/.dotnet/tools/dotnet-project-licenses</LicenseToolPath>
    <LicenseToolPath Condition="'$(OS)' == 'Windows_NT'">
      $(UserProfile)\.dotnet\tools\dotnet-project-licenses.exe</LicenseToolPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time only: drives MyPluginInfo from the <Version> above. -->
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/ConfigurationManager/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Constants/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Environment/EFTGameExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Loggers/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Notifications/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Runtime/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)/../Common/Sessions/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx 6 loader, Harmony, and the Il2CppInterop runtime the game types are proxied through. -->
    <Reference Include="0Harmony" HintPath="$(SptCore)\0Harmony.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(SptCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(SptCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(SptCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="SemanticVersioning" HintPath="$(SptCore)\SemanticVersioning.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(SptInterop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Il2CppSystem" HintPath="$(SptInterop)\Il2CppSystem.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unhollowed game assemblies. -->
    <Reference Include="Assembly-CSharp" HintPath="$(SptInterop)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Comfort" HintPath="$(SptInterop)\Comfort.dll" Private="false" />
    <Reference Include="Comfort.Unity" HintPath="$(SptInterop)\Comfort.Unity.dll" Private="false" />
    <Reference Include="ItemComponent.Types" HintPath="$(SptInterop)\ItemComponent.Types.dll" Private="false" />
    <Reference Include="Sirenix.Serialization" HintPath="$(SptInterop)\Sirenix.Serialization.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(SptInterop)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(SptInterop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(SptInterop)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(SptInterop)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(SptInterop)\UnityEngine.UI.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- SPT 5.0 renamed the client-side libraries from SPT.* to SPTushonka.*. -->
    <Reference Include="SPTushonka.Common" HintPath="$(Sptushonka)\SPTushonka.Common.dll" Private="false" />
    <Reference Include="SPTushonka.Core" HintPath="$(Sptushonka)\SPTushonka.Core.dll" Private="false" />
    <Reference Include="SPTushonka.Custom" HintPath="$(Sptushonka)\SPTushonka.Custom.dll" Private="false" />
    <Reference Include="SPTushonka.Reflection" HintPath="$(Sptushonka)\SPTushonka.Reflection.dll" Private="false" />
    <Reference Include="SPTushonka.SinglePlayer" HintPath="$(Sptushonka)\SPTushonka.SinglePlayer.dll" Private="false" />
    <!-- No reference to ConfigurationManager.dll: the attributes class it looks for is vendored into
         Sources/Common/ConfigurationManager, which is the pattern the plugin itself recommends. -->
  </ItemGroup>

  <Target Name="GenerateLicenseFile" AfterTargets="Publish" Condition="Exists('$(LicenseToolPath)')">
    <Message Text="Generating license file..." Importance="high" />

    <Exec
      Command="$(LicenseToolPath) --input &quot;$(MSBuildProjectFullPath)&quot; --output --outfile &quot;$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.Client.LICENSES.txt&quot;"
      EnvironmentVariables="DOTNET_ROLL_FORWARD=Major"
      ConsoleToMSBuild="true"
      IgnoreExitCode="false" />

    <Message Text="License file generated." Importance="high" />
  </Target>

  <Target Name="GenerateLicenseFileSkipped" AfterTargets="Publish" Condition="!Exists('$(LicenseToolPath)')">
    <Message Text="Skipping license file: $(LicenseToolPath) is not installed (dotnet tool install -g dotnet-project-licenses)." Importance="high" />
  </Target>

  <Target Name="CopyToPublishFolder" AfterTargets="GenerateLicenseFile;GenerateLicenseFileSkipped">
    <Message Text="Copying published files to /Publish folder..." Importance="high" />

    <ItemGroup>
      <PublishedFiles Include="$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.Client.dll" />
      <PublishedFiles Include="$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.Client.LICENSES.txt" Condition="Exists('$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.Client.LICENSES.txt')" />
    </ItemGroup>

    <Copy SourceFiles="@(PublishedFiles)"
      DestinationFolder="$(MSBuildProjectDirectory)/../../Publish/BepInEx/plugins" />
  </Target>
</Project>
